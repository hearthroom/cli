---
/**
 * The animated terminal on the landing page. Scene 1 is rendered on the server
 * so the page reads without JavaScript and under prefers-reduced-motion; the
 * script cycles through the scenes: type the command, print the output line by
 * line, hold, clear, next. It pauses when hidden or scrolled away.
 *
 * Line colours follow the `k` marks in demos.ts; the server render and the
 * animator share `classOf` below so both paint the same thing.
 */
import { heroScenes, type Line } from "../demos";
import { t, type Locale } from "../i18n";
interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale);
const scenes = heroScenes(locale).map((sc) => ({ ...sc, desc: s.scenes[sc.key], out: sc.out.map(norm) }));
function norm(l: Line): { t: string; k: string } {
  if (typeof l === "string") return l.startsWith("$ ") ? { t: l.slice(2), k: "cmd" } : { t: l, k: "" };
  return { t: l.t, k: l.k };
}
const first = scenes[0];
---
<section class="demo" aria-label="Demo">
  <h2 class="scene-cmd"><span class="p">$</span> <span id="scene-cmd">{first.cmd}</span></h2>
  <p class="scene-desc" id="scene-desc">{first.desc}</p>
  <div class="term term-hero">
    <div class="term-bar">
      <span class="dots"><i></i><i></i><i></i></span>
      <button class="term-pause" type="button" id="term-pause" aria-pressed="false" aria-label={s.terminal.pause} data-pause={s.terminal.pause} data-play={s.terminal.play}>
        <svg class="ic-pause" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M3 2.5A1.5 1.5 0 0 1 4.5 1h1A1.5 1.5 0 0 1 7 2.5v11A1.5 1.5 0 0 1 5.5 15h-1A1.5 1.5 0 0 1 3 13.5zm6 0A1.5 1.5 0 0 1 10.5 1h1A1.5 1.5 0 0 1 13 2.5v11a1.5 1.5 0 0 1-1.5 1.5h-1A1.5 1.5 0 0 1 9 13.5z"/></svg>
        <svg class="ic-play" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M4 2.3c0-.9 1-1.5 1.8-1L13.6 7c.7.5.7 1.5 0 2L5.8 14.7c-.8.5-1.8-.1-1.8-1z"/></svg>
      </button>
    </div>
    <pre aria-live="off"><code id="term-body"><span class="p">$ </span><span class="cmd">{first.cmd}</span>{"\n"}{first.out.map((l) => <>{l.k === "cmd" ? <><span class="p">$ </span><span class="cmd">{l.t}</span></> : <span class={l.k}>{l.t}</span>}{"\n"}</>)}</code></pre>
  </div>
  <p class="all"><a href="/manual/">{s.terminal.all} →</a></p>
</section>
<script is:inline define:vars={{ scenes }}>
  (function () {
    var body = document.getElementById("term-body");
    var cmdEl = document.getElementById("scene-cmd");
    var descEl = document.getElementById("scene-desc");
    var btn = document.getElementById("term-pause");
    if (!body || !btn) return;
    var reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    var paused = reduced, inView = true, visible = true, i = 0, timer = null, gen = 0;
    function setLabel() { btn.setAttribute("aria-label", paused ? btn.dataset.play : btn.dataset.pause); btn.setAttribute("aria-pressed", String(paused)); }
    setLabel();
    if (reduced) return; // static scene 1; nothing cycles
    var esc = function (t) { return t.replace(/[&<>]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]; }); };
    var line = function (l) { return l.k === "cmd" ? '<span class="p">$ </span><span class="cmd">' + esc(l.t) + "</span>" : '<span class="' + l.k + '">' + esc(l.t) + "</span>"; };
    var wait = function (ms, g) { return new Promise(function (r) { timer = setTimeout(function () { if (g === gen) r(); }, ms); }); };
    async function run(g) {
      while (g === gen) {
        while (paused || !visible) { await wait(250, g); if (g !== gen) return; }
        var sc = scenes[i];
        cmdEl.textContent = sc.cmd; descEl.textContent = sc.desc;
        body.innerHTML = '<span class="p">$ </span><span class="cmd"></span><span class="cursor"></span>';
        var typed = body.querySelector(".cmd");
        for (var c = 0; c < sc.cmd.length; c++) {
          while (paused || !visible) { await wait(250, g); if (g !== gen) return; }
          typed.textContent = sc.cmd.slice(0, c + 1);
          await wait(28 + Math.random() * 22, g); if (g !== gen) return;
        }
        await wait(350, g); if (g !== gen) return;
        body.querySelector(".cursor").remove();
        body.insertAdjacentHTML("beforeend", "\n");
        for (var k = 0; k < sc.out.length; k++) {
          while (paused || !visible) { await wait(250, g); if (g !== gen) return; }
          body.insertAdjacentHTML("beforeend", line(sc.out[k]) + "\n");
          await wait(k === 0 ? 260 : 70 + Math.random() * 60, g); if (g !== gen) return;
        }
        await wait(3600, g); if (g !== gen) return;
        i = (i + 1) % scenes.length;
      }
    }
    btn.addEventListener("click", function () { paused = !paused; setLabel(); });
    document.addEventListener("visibilitychange", function () { visible = !document.hidden && inView; });
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (es) { inView = es[0].isIntersecting; visible = inView && !document.hidden; }, { threshold: 0 }).observe(body);
    }
    // Start on the second scene so the static first one is not retyped at once.
    i = 1;
    setTimeout(function () { run(++gen); }, 2200);
  })();
</script>
