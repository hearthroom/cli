---
/**
 * One install control, like cli.github.com: an OS switcher, the command, Copy.
 * The OS is detected in the browser; the server renders macOS/Linux (the
 * same command) so the control is right without JavaScript for most readers.
 * Below it, the line this audience needs and gh does not: the agent handoff.
 */
import { t, type Locale } from "../i18n";
interface Props { locale: Locale; version: string; id?: string }
const { locale, version, id = "install" } = Astro.props;
const s = t(locale).install;
const sh = "curl -fsSL https://raw.githubusercontent.com/hearthroom/cli/main/install.sh | sh";
const ps = "irm https://raw.githubusercontent.com/hearthroom/cli/main/install.ps1 | iex";
const llms = "https://cli.hearthroom.club/llms.txt";
---
<div class="install-block" id={id}>
  <div class="install-ctl" data-install>
    <select aria-label="Operating system" data-os>
      <option value="mac">{s.os.mac}</option>
      <option value="linux">{s.os.linux}</option>
      <option value="windows">{s.os.windows}</option>
    </select>
    <code data-cmd data-sh={sh} data-ps={ps}>{sh}</code>
    <button type="button" data-copy={sh} data-copied={s.copied}>{s.copy}</button>
  </div>
  <p class="install-meta">
    <a href="https://github.com/hearthroom/cli/releases/latest" rel="noopener">{s.version(version)}</a>
    <a href="/guides/install/">{s.other} →</a>
  </p>
  <p class="agent-line">
    <span>{s.agent}</span>
    <code>{llms}</code>
    <button type="button" data-copy={llms} data-copied={s.copied}>{s.copy}</button>
  </p>
</div>
<script is:inline>
  (function () {
    var ua = navigator.userAgent, os = /Windows/.test(ua) ? "windows" : /Linux|Android|CrOS/.test(ua) && !/Mac/.test(ua) ? "linux" : "mac";
    document.querySelectorAll("[data-install]").forEach(function (box) {
      var sel = box.querySelector("[data-os]"), code = box.querySelector("[data-cmd]"), btn = box.querySelector("[data-copy]");
      function apply(v) { var c = v === "windows" ? code.dataset.ps : code.dataset.sh; code.textContent = c; btn.dataset.copy = c; }
      sel.value = os; apply(os);
      sel.addEventListener("change", function () { apply(sel.value); });
    });
  })();
</script>
