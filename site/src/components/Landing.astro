---
import Base from "../layouts/Base.astro";
import Install from "./Install.astro";
import HeroTerminal from "./HeroTerminal.astro";
import { t, type Locale, localePath } from "../i18n";
interface Props { locale: Locale; version: string }
const { locale, version } = Astro.props;
const s = t(locale);
---
<Base title="Hearthroom CLI" description={`${s.hero.title} ${s.hero.lead}`} locale={locale} markdown="/index.md" path={localePath(locale, "/")} section="home">
  <section class="hero">
    <h1>{s.hero.title}</h1>
    <p class="lead">{s.hero.lead}</p>
    <Install locale={locale} version={version} />
  </section>

  <HeroTerminal locale={locale} />

  <section class="props">
    {s.props.map((p) => <div class="prop"><h3>{p.title}</h3><p>{p.text}</p><a href={p.href}>{p.link} →</a></div>)}
  </section>

  <section class="again">
    <h2>{s.again.title}</h2>
    <p>{s.again.text}</p>
    <Install locale={locale} version={version} id="install-again" />
  </section>
</Base>
