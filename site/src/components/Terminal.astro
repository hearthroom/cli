---
/**
 * A terminal block. `lines` are rendered verbatim; a line starting with "$ "
 * is a prompt (copyable), "# " a comment, anything else output.
 */
interface Props {
  lines: string[];
  title?: string;
  copy?: string; // text the copy button copies (defaults to the first prompt)
  copyLabel?: string;
  copiedLabel?: string;
}
const { lines, title = "", copy, copyLabel = "Copy", copiedLabel = "Copied" } = Astro.props;
const firstPrompt = lines.find((l) => l.startsWith("$ "))?.slice(2) ?? "";
const toCopy = copy ?? firstPrompt;
---
<div class="term">
  <div class="term-bar">
    <span class="dots"><i></i><i></i><i></i></span>
    <span>{title}</span>
    {toCopy && <button class="copy" type="button" data-copy={toCopy} data-copied={copiedLabel}>{copyLabel}</button>}
  </div>
  <pre><code>{lines.map((l, i) => {
    if (l.startsWith("$ ")) return <Fragment key={i}><span class="p">$ </span>{l.slice(2)}{"\n"}</Fragment>;
    if (l.startsWith("# ")) return <Fragment key={i}><span class="c">{l}</span>{"\n"}</Fragment>;
    return <Fragment key={i}><span class="o">{l}</span>{"\n"}</Fragment>;
  })}</code></pre>
</div>
