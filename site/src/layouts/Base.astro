---
import "../styles/site.css";
import { LOCALES, t, type Locale, localePath } from "../i18n";

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** Path of the Markdown twin of this page, when it has one. */
  markdown?: string;
  /** Canonical path (locale-independent pages pass their own path). */
  path: string;
  section?: "home" | "manual" | "guides";
}
const { title, description, locale = "en", markdown, path, section } = Astro.props;
const canonical = new URL(path, "https://cli.hearthroom.club").href;
const s = t(locale);
const langNames: Record<Locale, string> = { en: "English", "zh-Hant": "繁體中文", "zh-Hans": "简体中文", ja: "日本語", ko: "한국어" };
---
<!doctype html>
<html lang={locale} data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown" />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://cli.hearthroom.club/icon-192.png" />
    <script is:inline>
      (function () {
        var m = "light";
        try { m = localStorage.getItem("mode") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"); } catch (e) {}
        document.documentElement.dataset.mode = m;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={localePath(locale, "/")}><img src="/icon-192.png" alt="" width="28" height="28" /> Hearthroom CLI</a>
        <nav class="nav" aria-label={s.navLabel}>
          <a href="/manual/" aria-current={section === "manual" ? "page" : undefined}>{s.nav.manual}</a>
          <a href="/guides/install/" aria-current={section === "guides" ? "page" : undefined}>{s.nav.guides}</a>
          <a class="ext" href="https://github.com/hearthroom/cli/releases" rel="noopener">{s.nav.releases}</a>
          <a class="ext" href="https://github.com/hearthroom/cli" rel="noopener">GitHub</a>
          <a class="ext" href="https://hearthroom.club" rel="noopener">hearthroom.club</a>
          <div class="ctl">
            <select id="lang" aria-label={s.language}>
              {LOCALES.map((l) => <option value={l} selected={l === locale}>{langNames[l]}</option>)}
            </select>
            <button id="mode" type="button" aria-label={s.theme}>◐</button>
          </div>
        </nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© Hearthroom · AGPL-3.0</span>
        <a href="https://github.com/hearthroom/cli" rel="noopener">GitHub</a>
        <a href="https://discord.gg/C7m85YPHmK" rel="noopener">Discord</a>
        <a href="https://hearthroom.club/developers" rel="noopener">{s.nav.developers}</a>
        <a href="/llms.txt">llms.txt</a>
        {markdown && <a href={markdown} class="md-link">{s.viewMarkdown}</a>}
      </div>
    </footer>
    <script is:inline define:vars={{ path, locale }}>
      document.getElementById("mode").addEventListener("click", function () {
        var next = document.documentElement.dataset.mode === "dark" ? "light" : "dark";
        document.documentElement.dataset.mode = next;
        try { localStorage.setItem("mode", next); } catch (e) {}
      });
      document.getElementById("lang").addEventListener("change", function (e) {
        var l = e.target.value;
        var p = path.replace(/^\/(zh-Hant|zh-Hans|ja|ko)(?=\/)/, "");
        if (p.indexOf("/manual") === 0) { location.href = p; return; }
        location.href = l === "en" ? p : "/" + l + p;
      });
      document.querySelectorAll("[data-copy]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var text = btn.getAttribute("data-copy");
          navigator.clipboard.writeText(text).then(function () {
            var old = btn.textContent; btn.textContent = btn.getAttribute("data-copied") || "✓";
            setTimeout(function () { btn.textContent = old; }, 1200);
          });
        });
      });
      document.querySelectorAll("[role=tablist]").forEach(function (list) {
        var tabs = list.querySelectorAll("[role=tab]");
        tabs.forEach(function (tab) {
          tab.addEventListener("click", function () {
            tabs.forEach(function (t) { t.setAttribute("aria-selected", "false"); document.getElementById(t.getAttribute("aria-controls")).hidden = true; });
            tab.setAttribute("aria-selected", "true");
            document.getElementById(tab.getAttribute("aria-controls")).hidden = false;
          });
        });
      });
    </script>
  </body>
</html>
