---
import "../styles/site.css";
import { LOCALES, LANG_NAMES, t, type Locale, localePath } from "../i18n";

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** Path of the Markdown twin of this page, when it has one. */
  markdown?: string;
  /** Canonical path (locale-independent pages pass their own path). */
  path: string;
  section?: "home" | "manual" | "guides";
}
const { title, description, locale = "en", markdown, path, section } = Astro.props;
const site = "https://cli.hearthroom.club";
const canonical = new URL(path, site).href;
const s = t(locale);
// The landing exists in every locale; other pages are English only.
const localized = section === "home";
const basePath = path.replace(/^\/(zh-Hant|zh-Hans|ja|ko)(?=\/)/, "");
---
<!doctype html>
<html lang={locale} data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {localized && LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, basePath), site).href} />)}
    {localized && <link rel="alternate" hreflang="x-default" href={new URL(basePath, site).href} />}
    <link rel="icon" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} title="Markdown" />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://cli.hearthroom.club/icon-192.png" />
    <script is:inline>
      (function () {
        var m = "light";
        try { m = localStorage.getItem("mode") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"); } catch (e) {}
        document.documentElement.dataset.mode = m;
      })();
    </script>
    {path === "/" && (
      // First visit to the English landing: follow the browser language, with
      // English as the fallback. A language the visitor picked in the menu is
      // stored and wins. Agents and crawlers run no script and stay on "/".
      <script is:inline>
        (function () {
          var pick = null;
          try { pick = localStorage.getItem("lang"); } catch (e) {}
          if (!pick) {
            var ls = navigator.languages || [navigator.language || ""];
            for (var i = 0; i < ls.length && !pick; i++) {
              var l = String(ls[i]).toLowerCase();
              if (l.indexOf("zh") === 0) pick = /hant|tw|hk|mo/.test(l) ? "zh-Hant" : "zh-Hans";
              else if (l.indexOf("ja") === 0) pick = "ja";
              else if (l.indexOf("ko") === 0) pick = "ko";
              else if (l.indexOf("en") === 0) pick = "en";
            }
          }
          if (pick && pick !== "en" && /^(zh-Hant|zh-Hans|ja|ko)$/.test(pick)) location.replace("/" + pick + "/" + location.search + location.hash);
        })();
      </script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={localePath(locale, "/")}><img src="/icon-192.png" alt="" width="28" height="28" /> Hearthroom CLI</a>
        <nav class="nav" aria-label={s.navLabel}>
          <a href="/manual/" aria-current={section === "manual" ? "page" : undefined}>{s.nav.manual}</a>
          <a href="/guides/install/" aria-current={section === "guides" ? "page" : undefined}>{s.nav.guides}</a>
          <a href="https://github.com/hearthroom/cli/releases" rel="noopener">{s.nav.releases}</a>
          <a href="https://github.com/hearthroom/cli" rel="noopener">GitHub</a>
          <details class="menu lang-menu">
            <summary aria-label={s.language}><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M1.75 8h12.5M8 1.75c2.2 2.1 2.2 10.4 0 12.5M8 1.75c-2.2 2.1-2.2 10.4 0 12.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><span>{LANG_NAMES[locale]}</span><svg class="caret" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M4 6h8l-4 4.5z"/></svg></summary>
            <ul>
              {LOCALES.map((l) => <li><a href={localized ? localePath(l, basePath) : localePath(l, "/")} hreflang={l} lang={l} data-lang={l} aria-current={l === locale ? "true" : undefined}>{LANG_NAMES[l]}</a></li>)}
            </ul>
          </details>
          <button id="mode" type="button" aria-label={s.theme}>
            <svg class="ic-sun" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M3.05 12.95l1.4-1.4M11.55 4.45l1.4-1.4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <svg class="ic-moon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M9.6 1.6a.75.75 0 0 1 .8-.2 7 7 0 1 1-8.9 8.9.75.75 0 0 1 .95-.95A5.5 5.5 0 0 0 9.4 2.4a.75.75 0 0 1 .2-.8Z"/></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© Hearthroom · AGPL-3.0</span>
        <a href="https://github.com/hearthroom/cli" rel="noopener">GitHub</a>
        <a href="https://discord.gg/C7m85YPHmK" rel="noopener">Discord</a>
        <a href="https://hearthroom.club" rel="noopener">hearthroom.club</a>
        <a href="https://hearthroom.club/developers" rel="noopener">{s.nav.developers}</a>
        <a href="/llms.txt">llms.txt</a>
        {markdown && <a href={markdown} class="md-link">{s.viewMarkdown}</a>}
      </div>
    </footer>
    <script is:inline>
      document.getElementById("mode").addEventListener("click", function () {
        var next = document.documentElement.dataset.mode === "dark" ? "light" : "dark";
        document.documentElement.dataset.mode = next;
        try { localStorage.setItem("mode", next); } catch (e) {}
      });
      // A language chosen here is remembered, so "/" stops redirecting away from it.
      document.querySelectorAll("[data-lang]").forEach(function (a) {
        a.addEventListener("click", function () { try { localStorage.setItem("lang", a.dataset.lang); } catch (e) {} });
      });
      // Menus: one open at a time; Escape and clicks outside close them.
      var menus = document.querySelectorAll("details.menu");
      menus.forEach(function (m) {
        m.addEventListener("toggle", function () { if (m.open) menus.forEach(function (o) { if (o !== m) o.open = false; }); });
      });
      document.addEventListener("click", function (e) { menus.forEach(function (m) { if (m.open && !m.contains(e.target)) m.open = false; }); });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape") menus.forEach(function (m) { m.open = false; }); });
      document.querySelectorAll("[data-copy]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          navigator.clipboard.writeText(btn.getAttribute("data-copy")).then(function () {
            var label = btn.querySelector(".copy-label");
            btn.classList.add("is-copied");
            if (label) label.textContent = btn.getAttribute("data-copied");
            setTimeout(function () { btn.classList.remove("is-copied"); if (label) label.textContent = btn.getAttribute("data-label"); }, 1500);
          });
        });
      });
    </script>
  </body>
</html>
